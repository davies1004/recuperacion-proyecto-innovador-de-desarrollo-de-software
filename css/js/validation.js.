
/* =====================================
   ECORECICLA - VALIDACIÓN DE DATOS
===================================== */

function validarRegistro(nombre, categoria, cantidad) {
  const nombreLimpio = nombre.trim();
  const cantidadNumero = Number(cantidad);

  const categoriasPermitidas = [
    "Plástico",
    "Papel y cartón",
    "Vidrio",
    "Metal"
  ];

  if (nombreLimpio.length < 2) {
    return "El nombre del material debe tener al menos 2 caracteres.";
  }

  if (nombreLimpio.length > 60) {
    return "El nombre no puede superar los 60 caracteres.";
  }

  if (!categoriasPermitidas.includes(categoria)) {
    return "Selecciona una categoría de reciclaje válida.";
  }

  if (
    cantidad === "" ||
    !Number.isInteger(cantidadNumero) ||
    cantidadNumero < 1 ||
    cantidadNumero > 10000
  ) {
    return "La cantidad debe ser un número entero entre 1 y 10,000.";
  }

  return null;
}
